---
import { href } from '../lib/data.mjs';

const {
  title,
  description = 'Hackathon winners and what everyone else built, analyzed by why they stood out — plus a demo-first planning harness.',
  jsonld,
} = Astro.props;
const nav = [
  { label: 'Explore', links: [['/projects/', 'All references'], ['/hackathons/', 'Events'], ['/similar/', 'Find similar projects'], ['/deal/', 'Discover a project']] },
  { label: 'Build', links: [['/build/', 'Create a brief'], ['/guide/', 'Planning guide']] },
  { label: 'Learn', links: [['/patterns/', 'Winning patterns'], ['/mechanisms/', 'Mechanisms'], ['/resources/', 'Videos & articles']] },
];
const path = Astro.url.pathname;
const fullTitle = title ? `${title} · CrafterWIKI` : 'CrafterWIKI — references for your next build';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const icon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23ff8845'/%3E%3Cpath d='M21 11.5a7 7 0 1 0 0 9' stroke='%230f1115' stroke-width='3.2' fill='none' stroke-linecap='round'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('cw-theme') === 'light' ? 'light' : 'dark'; } catch { document.documentElement.dataset.theme = 'dark'; }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={icon} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('/')}>Crafter<span>WIKI</span></a>
        <nav class="primary" aria-label="Primary">
          {nav.map(group => <details class="nav-topic" name="site-navigation">
            <summary class:list={{ active: group.links.some(([p]) => path.startsWith(href(p))) }}>{group.label}<span aria-hidden="true">⌄</span></summary>
            <div class="topic-menu">{group.links.map(([p,label])=><a href={href(p)} aria-current={path.startsWith(href(p))?'page':undefined}>{label}</a>)}</div>
          </details>)}
        </nav>
        <div class="display-controls" aria-label="Display preferences" translate="no">
          <a id="site-repo" class="repo-link" href="https://github.com/RikepilB/crafterwiki" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository" title="GitHub repository">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <select id="site-language" aria-label="Language / Idioma"><option value="en">EN</option><option value="es">ES</option></select>
          <button id="site-theme" type="button" aria-label="Switch to light mode" aria-pressed="false">☀</button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <p><b>CrafterWIKI</b> · References for builders.</p>
        <p class="meta">
          <a href={href('/api/v0/manifest.json')}>Static API</a> ·
          <a href={href('/guide/#agents')}>CLI &amp; MCP</a> ·
          <a href={href('/guide/#corrections')}>Corrections &amp; removal</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  import { initLanguage } from '../scripts/language.js';
  initLanguage();
  const language = document.querySelector('#site-language');
  const theme = document.querySelector('#site-theme');
  function syncTheme() {
    const light = document.documentElement.dataset.theme === 'light';
    const es = document.documentElement.lang === 'es';
    if (theme instanceof HTMLButtonElement) {
      theme.textContent = light ? '☾' : '☀';
      theme.setAttribute('aria-pressed', String(light));
      theme.setAttribute('aria-label', es ? (light ? 'Cambiar al modo oscuro' : 'Cambiar al modo claro') : (light ? 'Switch to dark mode' : 'Switch to light mode'));
      theme.title = theme.getAttribute('aria-label') ?? '';
    }
    const repo = document.querySelector('#site-repo');
    if (repo instanceof HTMLAnchorElement) {
      repo.setAttribute('aria-label', es ? 'Repositorio en GitHub' : 'GitHub repository');
      repo.title = repo.getAttribute('aria-label') ?? '';
    }
  }
  if (language instanceof HTMLSelectElement) {
    language.value = document.documentElement.lang === 'es' ? 'es' : 'en';
    language.addEventListener('change', () => {
      window.dispatchEvent(new CustomEvent('crafter-language', { detail: language.value }));
      syncTheme();
    });
  }
  theme?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('cw-theme', next); } catch { /* Keep this page's choice when storage is unavailable. */ }
    syncTheme();
  });
  syncTheme();
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.nav-topic')];
  for (const menu of menus) menu.addEventListener('toggle', () => {
    if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node) for (const menu of menus) if (!menu.contains(event.target)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = menus.find(menu=>menu.open);
    if (open) { open.open=false; open.querySelector('summary')?.focus(); }
  });
  document.addEventListener('focusin', (event) => {
    if (event.target instanceof Node && !document.querySelector('nav.primary')?.contains(event.target)) for (const menu of menus) menu.open=false;
  });
</script>

<style is:global>
@font-face { font-family:Geologica; src:url(/fonts/geologica-latin.woff2)format("woff2"); font-style:normal; font-weight:100 900; font-display:swap}
@font-face { font-family:"Space Grotesk"; src:url(/fonts/space-grotesk-latin.woff2)format("woff2"); font-style:normal; font-weight:300 700; font-display:swap}
:root { --display:"Space Grotesk", "Geologica", sans-serif; --bg:#100e0b; --ink:#f0efea; --accent:#ff8845; --surface:color-mix(in srgb, var(--bg) 96%, var(--ink)); --surface-2:color-mix(in srgb, var(--bg) 92%, var(--ink)); --muted:color-mix(in srgb, var(--ink) 74%, var(--bg)); --line:color-mix(in srgb, var(--ink) 20%, transparent); --accent-ink:var(--bg); --accent-soft:var(--bg); --win:var(--ink); --win-soft:var(--bg); --vote:var(--ink); --vote-soft:var(--bg); --feat:var(--ink); --feat-soft:var(--bg); --warn:var(--ink); --warn-soft:var(--bg); --neutral:var(--ink); --neutral-soft:var(--bg); --radius:6px; --sans:"Geologica", sans-serif; --mono:var(--sans); color-scheme:dark}
:root[data-theme=light] { --bg:#f6f4ee; --ink:#202420; --accent:#b44822; color-scheme:light}
* { box-sizing:border-box}
.display-controls { align-items:center; gap:4px; display:flex}
.display-controls select,.display-controls button { border:1px solid var(--line); background:var(--bg); width:auto; min-width:44px; min-height:44px; color:var(--ink); font:500 .8rem var(--sans); cursor:pointer; border-radius:6px; padding:6px}
.display-controls button { font-size:1.25rem}
.display-controls .repo-link { border:1px solid var(--line); background:var(--bg); color:var(--ink); min-width:44px; min-height:44px; align-items:center; justify-content:center; display:inline-flex; border-radius:6px; text-decoration:none}
.display-controls .repo-link:hover { color:var(--accent)}
@media (width<=760px) { .display-controls { margin-left:auto}
nav.primary { order:3; justify-content:space-between; width:100%; margin-left:0}
}
[hidden] { display:none!important}
html { -webkit-text-size-adjust:100%}
body { background:var(--bg); color:var(--ink); font:16px/1.6 var(--sans); margin:0}
.wrap { max-width:1140px; margin:0 auto; padding-inline:20px}
a { color:inherit; text-decoration-color:color-mix(in srgb, var(--accent) 70%, transparent); text-underline-offset:3px}
a:hover { color:var(--accent)}
:focus-visible { outline:2px solid var(--accent); outline-offset:2px; border-radius:4px}
h1,h2,h3 { letter-spacing:-.018em; line-height:1.15}
h1 { margin:.15em 0 .3em; font-size:clamp(2rem,4.6vw,3.3rem); font-family:var(--display); letter-spacing:-.035em}
h2 { margin:2.4rem 0 .9rem; font-size:1.4rem}
h3 { margin:0; font-size:1.05rem}
p { margin:0 0 .9em}
.eyebrow { display:none}
.lede { color:var(--muted); max-width:66ch; font-size:1.14rem}
.muted { color:var(--muted)}
.meta { font:.8rem/1.45 var(--mono); color:var(--muted); margin:0}
.skip { position:absolute; left:-999px}
.skip:focus { z-index:30; background:var(--surface); padding:8px 12px; top:12px; left:12px}
.site-header { background:var(--bg); border-bottom:1px solid var(--line); position:static}
.bar { flex-wrap:wrap; align-items:center; gap:8px 18px; min-height:60px; padding-block:8px; display:flex}
.brand { font:700 1.3rem/1 var(--display); letter-spacing:-.045em; color:var(--accent); text-decoration:none}
.brand span { color:inherit}
nav.primary { flex-wrap:wrap; gap:2px; margin-left:auto; display:flex}
nav.primary a { color:var(--muted); border-radius:8px; padding:6px 10px; font-size:.9rem; text-decoration:none}
nav.primary a:hover,nav.primary a[aria-current=page] { color:var(--ink); background:var(--surface-2)}
main { padding-block:28px 72px}
.site-footer { border-top:1px solid var(--line); color:var(--muted); padding-block:26px; font-size:.92rem}
.footer-grid { flex-wrap:wrap; justify-content:space-between; gap:8px 32px; display:flex}
.footer-grid p { max-width:62ch}
.grid { grid-template-columns:repeat(auto-fill,minmax(min(100%,310px),1fr)); gap:14px; display:grid}
.card { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); flex-direction:column; gap:8px; min-width:0; padding:16px; display:flex}
.card p { margin:0}
.reference-actions { border-top:1px solid var(--line); flex-wrap:wrap; gap:8px 14px; margin-top:auto; padding-top:12px; font-size:.82rem; font-weight:600; display:flex}
.card-links { margin-left:auto; font-weight:400}
.card-links summary { cursor:pointer}
.card-links div { gap:12px; padding-top:12px; display:grid}
.card { border-radius:10px; gap:12px; padding:20px}
.card p:not(.meta) { font-size:.9rem; line-height:1.6}
.card .meta { font-size:.78rem}
.card-media { background:var(--bg); aspect-ratio:16/9; border-radius:9px 9px 0 0; margin:-20px -20px 6px; display:block; position:relative; overflow:hidden}
.card-media img { object-fit:contain; width:100%; height:100%}
.card-media:hover img { opacity:.95}
.card-media span { background:var(--bg); color:var(--ink); font:600 .75rem var(--sans); border-radius:4px; padding:6px 10px; position:absolute; bottom:12px; left:12px}
.nav-more { color:var(--muted); font-size:.9rem; position:relative}
.nav-more summary { cursor:pointer; padding:6px 10px}
.nav-more div { background:var(--surface); border:1px solid var(--line); min-width:160px; box-shadow:none; border-radius:8px; padding:8px; display:grid; position:absolute; top:100%; right:0}
.nav-more summary { align-items:center; gap:7px; min-height:44px; list-style:none; display:flex}
.nav-more summary::-webkit-details-marker { display:none}
.nav-more[open] summary { color:var(--accent)}
.nav-more .nav-menu { z-index:30; min-width:230px; padding:12px}
.nav-menu p { margin:10px 10px 3px; font-size:.72rem; font-weight:600}
nav.primary a { align-items:center; min-height:44px; display:inline-flex}
.nav-menu a { width:100%}
.bar { padding-block:14px}
@media (width<=600px) { nav.primary { justify-content:space-between; gap:0; width:100%; margin:6px 0 0}
nav.primary a,.nav-more summary { padding-inline:6px; font-size:.78rem}
}
@media (prefers-reduced-motion:reduce) { .card-media img { transition:none}
}
.card h3 a { text-decoration:none}
.card h3 a:hover { text-decoration:underline}
.card-top { flex-wrap:wrap; align-items:center; gap:6px; display:flex}
.shared b { color:var(--ink); font-weight:600}
.badge { font:600 .7rem/1 var(--mono); text-transform:none; letter-spacing:0; white-space:nowrap; text-overflow:ellipsis; border-radius:999px; align-items:center; max-width:100%; padding:5px 8px; display:inline-flex; overflow:hidden}
.badge.win { color:var(--win); background:var(--win-soft)}
.badge.vote { color:var(--vote); background:var(--vote-soft)}
.badge.feat { color:var(--feat); background:var(--feat-soft)}
.badge.warn { color:var(--warn); background:var(--warn-soft)}
.badge.neutral { color:var(--neutral); background:var(--neutral-soft)}
.badge.accent { color:var(--accent); background:var(--accent-soft)}
.chips { flex-wrap:wrap; gap:6px; margin:0; padding:0; list-style:none; display:flex}
.chip { font:.76rem/1.2 var(--mono); border:1px solid var(--line); background:var(--surface-2); border-radius:6px; padding:4px 8px; text-decoration:none; display:inline-block}
a.chip:hover { border-color:var(--accent)}
.btn { border:1px solid var(--line); background:var(--surface); color:var(--ink); font:600 .95rem/1.2 var(--sans); cursor:pointer; border-radius:10px; align-items:center; gap:8px; padding:10px 16px; text-decoration:none; display:inline-flex}
.btn:hover { border-color:var(--accent); color:var(--ink)}
.btn.primary { background:var(--accent); border-color:var(--accent); color:var(--accent-ink)}
.btn.primary:hover { color:var(--accent-ink); text-decoration:underline}
.row { flex-wrap:wrap; align-items:center; gap:10px; display:flex}
.panel { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); gap:12px; margin:18px 0; padding:16px; display:grid}
.form-row { flex-wrap:wrap; align-items:end; gap:10px 14px; display:flex}
.field { color:var(--muted); gap:4px; min-width:0; font-size:.78rem; display:grid}
.grow { flex:260px}
input[type=search],select { font:inherit; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:8px; width:100%; max-width:100%; padding:9px 10px; font-size:.95rem}
select { min-width:150px}
.toggle { align-items:center; gap:7px; font-size:.9rem; display:inline-flex}
.toggle input { accent-color:var(--accent); width:16px; height:16px}
.table-wrap { border:1px solid var(--line); border-radius:var(--radius); background:var(--surface); overflow-x:auto}
table { border-collapse:collapse; width:100%; font-size:.92rem}
th,td { text-align:left; vertical-align:top; border-bottom:1px solid var(--line); padding:10px 12px}
th { font:600 .7rem/1.2 var(--mono); text-transform:none; letter-spacing:0; color:var(--muted); background:var(--surface-2); white-space:nowrap}
tr:last-child td { border-bottom:0}
.stats { grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; margin:28px 0 8px; display:grid}
.stat { border-left:3px solid var(--accent); padding:2px 14px}
.stat b { letter-spacing:-.02em; font-size:2rem; line-height:1.1; display:block}
.stat span { color:var(--muted); font-size:.9rem}
.facts { grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:10px; margin:18px 0; padding:0; display:grid}
.fact { background:var(--surface); border:1px solid var(--line); border-radius:10px; min-width:0; padding:10px 12px}
.fact dt { font:600 .68rem/1 var(--mono); text-transform:uppercase; letter-spacing:.07em; color:var(--muted); margin-bottom:6px}
.fact dd { overflow-wrap:anywhere; margin:0}
.two-col { grid-template-columns:minmax(0,1.7fr) minmax(0,1fr); gap:8px 40px; display:grid}
@media (width<=860px) { .two-col { grid-template-columns:minmax(0,1fr)}
}
.bars { gap:8px; margin:0; padding:0; list-style:none; display:grid}
.bar-row { grid-template-columns:minmax(0,13rem) minmax(40px,1fr) 3.4rem; align-items:center; gap:10px; font-size:.9rem; display:grid}
.bar-label { overflow-wrap:anywhere}
.bar-track { background:var(--surface-2); border-radius:99px; height:10px; overflow:hidden}
.bar-fill { background:var(--accent); border-radius:99px; height:100%; display:block}
.bar-n { font:.8rem var(--mono); color:var(--muted); text-align:right}
@media (width<=520px) { .bar-row { grid-template-columns:minmax(0,8.5rem) minmax(30px,1fr) 3rem}
}
.callout { border:1px solid var(--line); border-left:4px solid var(--warn); background:var(--warn-soft); border-radius:10px; margin:16px 0; padding:12px 14px}
.callout.info { border-left-color:var(--vote); background:var(--vote-soft)}
.claims { gap:10px; margin:0; padding:0; list-style:none; display:grid}
.claim { background:var(--surface); border:1px solid var(--line); border-radius:10px; justify-items:start; gap:6px; padding:12px 14px; display:grid}
.basis { font:600 .68rem/1 var(--mono); text-transform:none; letter-spacing:0; border-radius:6px; padding:4px 7px}
.basis.organizer-stated { color:var(--win); background:var(--win-soft)}
.basis.team-stated { color:var(--vote); background:var(--vote-soft)}
.basis.curator-inference { color:var(--warn); background:var(--warn-soft); outline-offset:-1px; outline:1px dashed}
.deflist { gap:12px; margin:0; display:grid}
.deflist dt { font-weight:650}
.deflist dd { color:var(--muted); margin:2px 0 0}
code,pre { font-family:var(--mono); font-size:.86em}
pre { background:var(--surface-2); border:1px solid var(--line); border-radius:10px; padding:12px 14px; line-height:1.5; overflow-x:auto}
ol.sources { overflow-wrap:anywhere; gap:6px; padding-left:1.3em; font-size:.92rem; display:grid}
.crumbs a { text-decoration:none}
.crumbs a:hover { text-decoration:underline}
.steps { counter-reset:step; gap:10px; margin:0; padding:0; list-style:none; display:grid}
.steps li { counter-increment:step; background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:12px 14px 12px 52px; position:relative}
.steps li:before { content:counter(step); width:26px; height:26px; font:700 .8rem/1 var(--mono); background:var(--accent-soft); color:var(--accent); border-radius:50%; place-items:center; display:grid; position:absolute; top:12px; left:14px}
.steps li.gate { border-color:var(--accent)}
.checks { flex-wrap:wrap; gap:6px 14px; padding:10px 2px 4px; display:flex}
details.group { border:1px solid var(--line); background:var(--bg); border-radius:10px; padding:8px 12px}
details.group summary { cursor:pointer; font-size:.92rem; font-weight:600}


  @media (max-width: 600px) { nav.primary { flex-wrap: nowrap; } nav.primary a, .nav-more summary { font-size: .74rem; padding-inline: 4px; } }
  nav.primary { position:relative; gap:12px; }
  .nav-topic { position:relative; }
  .nav-topic > summary { display:flex; gap:8px; align-items:center; min-height:44px; padding:8px 12px; cursor:pointer; list-style:none; border-radius:6px; font-size:.9rem; color:var(--muted); }
  .nav-topic > summary::-webkit-details-marker { display:none; }
  .nav-topic > summary.active, .nav-topic[open] > summary { background:var(--surface-2); color:var(--ink); }
  .nav-topic summary span { font-size:.7rem; }
  .topic-menu { position:absolute; right:0; top:calc(100% + 6px); display:grid; width:230px; padding:8px; border:1px solid var(--line); border-radius:8px; background:var(--surface); z-index:40; box-shadow:0 10px 28px color-mix(in srgb,var(--bg) 70%,transparent); }
  nav.primary .topic-menu a { display:flex; width:100%; padding:10px 12px; }
  @media (max-width:760px) {
    nav.primary { justify-content:space-between; gap:0; }
    .nav-topic { position:static; }
    .nav-topic > summary { font-size:.9rem; padding-inline:12px; }
    .topic-menu { top:100%; left:0; right:0; width:auto; }
  }
</style>
