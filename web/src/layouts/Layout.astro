---
import { href } from '../lib/data.mjs';

const {
  title,
  description = 'Hackathon winners and what everyone else built, analyzed by why they stood out — plus a demo-first planning harness.',
  jsonld,
} = Astro.props;
const nav = [
  ['/projects/', 'Projects'],
  ['/hackathons/', 'Hackathons'],
  ['/mechanisms/', 'Mechanisms'],
  ['/patterns/', 'Patterns'],
  ['/similar/', 'Similar'],
  ['/deal/', 'Deal me one'],
  ['/guide/', 'Guide'],
];
const path = Astro.url.pathname;
const fullTitle = title ? `${title} · CrafterWIKI` : 'CrafterWIKI — know why hackathon projects win';
const icon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23d9480f'/%3E%3Cpath d='M21 11.5a7 7 0 1 0 0 9' stroke='white' stroke-width='3.2' fill='none' stroke-linecap='round'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={icon} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href('/')}>Crafter<span>WIKI</span></a>
        <nav class="primary" aria-label="Primary">
          {nav.map(([p, label]) => (
            <a href={href(p)} aria-current={path.startsWith(href(p)) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <p><b>CrafterWIKI</b> — an open, provenance-first corpus. Every placement is labelled and every
          “why it stood out” claim says who said it.</p>
        <p class="meta">
          <a href={href('/api/v0/manifest.json')}>Static API</a> ·
          <a href={href('/guide/#agents')}>CLI &amp; MCP</a> ·
          <a href={href('/guide/#corrections')}>Corrections &amp; removal</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f4ee; --surface: #ffffff; --surface-2: #efebe2; --ink: #16181d; --muted: #5b606b; --line: #ddd7ca;
    --accent: #c2410c; --accent-ink: #ffffff; --accent-soft: #fde8da;
    --win: #1c6e46; --win-soft: #dcf0e4; --vote: #1d5bb0; --vote-soft: #dfe9f8;
    --feat: #6a3db3; --feat-soft: #ece4f8; --warn: #8a5a00; --warn-soft: #faefd4;
    --neutral: #5b606b; --neutral-soft: #ebe7de;
    --radius: 12px;
    --sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --mono: ui-monospace, 'SFMono-Regular', 'Cascadia Mono', Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115; --surface: #161a21; --surface-2: #1d222b; --ink: #ecebe6; --muted: #9ba1ac; --line: #2a2f39;
      --accent: #ff8a4c; --accent-ink: #1b0c03; --accent-soft: #3b2215;
      --win: #63d39a; --win-soft: #142d20; --vote: #86b4ff; --vote-soft: #172641;
      --feat: #c6a6ff; --feat-soft: #291f3e; --warn: #f1c35a; --warn-soft: #362b12;
      --neutral: #a4a9b3; --neutral-soft: #232833;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 var(--sans); }
  .wrap { max-width: 1140px; margin: 0 auto; padding-inline: 20px; }
  a { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 70%, transparent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.018em; }
  h1 { font-size: clamp(2rem, 4.6vw, 3.3rem); margin: 0.15em 0 0.3em; }
  h2 { font-size: 1.4rem; margin: 2.4rem 0 0.9rem; }
  h3 { font-size: 1.05rem; margin: 0; }
  p { margin: 0 0 0.9em; }
  .eyebrow { font: 600 0.74rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin: 0; }
  .lede { font-size: 1.14rem; color: var(--muted); max-width: 66ch; }
  .muted { color: var(--muted); }
  .meta { font: 0.8rem/1.45 var(--mono); color: var(--muted); margin: 0; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 12px; top: 12px; z-index: 30; background: var(--surface); padding: 8px 12px; }

  .site-header { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 8px 18px; min-height: 60px; flex-wrap: wrap; padding-block: 8px; }
  .brand { font: 800 1.2rem/1 var(--sans); letter-spacing: -0.03em; text-decoration: none; }
  .brand span { color: var(--accent); }
  nav.primary { display: flex; flex-wrap: wrap; gap: 2px; margin-left: auto; }
  nav.primary a { text-decoration: none; padding: 6px 10px; border-radius: 8px; font-size: 0.9rem; color: var(--muted); }
  nav.primary a:hover, nav.primary a[aria-current='page'] { color: var(--ink); background: var(--surface-2); }
  main { padding-block: 28px 72px; }
  .site-footer { border-top: 1px solid var(--line); padding-block: 26px; color: var(--muted); font-size: 0.92rem; }
  .footer-grid { display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: space-between; }
  .footer-grid p { max-width: 62ch; }

  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr)); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .card p { margin: 0; }
  .card h3 a { text-decoration: none; }
  .card h3 a:hover { text-decoration: underline; }
  .card-top { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .shared b { color: var(--ink); font-weight: 600; }
  .badge { display: inline-flex; align-items: center; font: 600 0.7rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; padding: 5px 8px; border-radius: 999px; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
  .badge.win { color: var(--win); background: var(--win-soft); }
  .badge.vote { color: var(--vote); background: var(--vote-soft); }
  .badge.feat { color: var(--feat); background: var(--feat-soft); }
  .badge.warn { color: var(--warn); background: var(--warn-soft); }
  .badge.neutral { color: var(--neutral); background: var(--neutral-soft); }
  .badge.accent { color: var(--accent); background: var(--accent-soft); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .chip { display: inline-block; font: 0.76rem/1.2 var(--mono); padding: 4px 8px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface-2); text-decoration: none; }
  a.chip:hover { border-color: var(--accent); }

  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 600 0.95rem/1.2 var(--sans); text-decoration: none; cursor: pointer; }
  .btn:hover { border-color: var(--accent); color: var(--ink); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .btn.primary:hover { filter: brightness(1.06); color: var(--accent-ink); }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }

  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; margin: 18px 0; display: grid; gap: 12px; }
  .form-row { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: end; }
  .field { display: grid; gap: 4px; font-size: 0.78rem; color: var(--muted); min-width: 0; }
  .grow { flex: 1 1 260px; }
  input[type='search'], select { font: inherit; font-size: 0.95rem; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 9px 10px; width: 100%; max-width: 100%; }
  select { min-width: 150px; }
  .toggle { display: inline-flex; gap: 7px; align-items: center; font-size: 0.9rem; }
  .toggle input { accent-color: var(--accent); width: 16px; height: 16px; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; font-size: 0.92rem; }
  th, td { text-align: left; vertical-align: top; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  th { font: 600 0.7rem/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); background: var(--surface-2); white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; margin: 28px 0 8px; }
  .stat { border-left: 3px solid var(--accent); padding: 2px 14px; }
  .stat b { display: block; font-size: 2rem; line-height: 1.1; letter-spacing: -0.02em; }
  .stat span { color: var(--muted); font-size: 0.9rem; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin: 18px 0; padding: 0; }
  .fact { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 0; }
  .fact dt { font: 600 0.68rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); margin-bottom: 6px; }
  .fact dd { margin: 0; overflow-wrap: anywhere; }

  .two-col { display: grid; gap: 8px 40px; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); }
  @media (max-width: 860px) { .two-col { grid-template-columns: minmax(0, 1fr); } }

  .bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .bar-row { display: grid; grid-template-columns: minmax(0, 13rem) minmax(40px, 1fr) 3.4rem; gap: 10px; align-items: center; font-size: 0.9rem; }
  .bar-label { overflow-wrap: anywhere; }
  .bar-track { height: 10px; border-radius: 99px; background: var(--surface-2); overflow: hidden; }
  .bar-fill { display: block; height: 100%; border-radius: 99px; background: var(--accent); }
  .bar-n { font: 0.8rem var(--mono); color: var(--muted); text-align: right; }
  @media (max-width: 520px) { .bar-row { grid-template-columns: minmax(0, 8.5rem) minmax(30px, 1fr) 3rem; } }

  .callout { border: 1px solid var(--line); border-left: 4px solid var(--warn); background: var(--warn-soft); border-radius: 10px; padding: 12px 14px; margin: 16px 0; }
  .callout.info { border-left-color: var(--vote); background: var(--vote-soft); }
  .claims { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .claim { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; display: grid; gap: 6px; justify-items: start; }
  .basis { font: 600 0.68rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 7px; border-radius: 6px; }
  .basis.organizer-stated { color: var(--win); background: var(--win-soft); }
  .basis.team-stated { color: var(--vote); background: var(--vote-soft); }
  .basis.curator-inference { color: var(--warn); background: var(--warn-soft); outline: 1px dashed currentColor; outline-offset: -1px; }
  .deflist { display: grid; gap: 12px; margin: 0; }
  .deflist dt { font-weight: 650; }
  .deflist dd { margin: 2px 0 0; color: var(--muted); }
  code, pre { font-family: var(--mono); font-size: 0.86em; }
  pre { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; overflow-x: auto; line-height: 1.5; }
  ol.sources { padding-left: 1.3em; display: grid; gap: 6px; font-size: 0.92rem; overflow-wrap: anywhere; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .steps { counter-reset: step; list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .steps li { counter-increment: step; position: relative; padding: 12px 14px 12px 52px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
  .steps li::before { content: counter(step); position: absolute; left: 14px; top: 12px; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font: 700 0.8rem/1 var(--mono); background: var(--accent-soft); color: var(--accent); }
  .steps li.gate { border-color: var(--accent); }
  .checks { display: flex; flex-wrap: wrap; gap: 6px 14px; padding: 10px 2px 4px; }
  details.group { border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; background: var(--bg); }
  details.group summary { cursor: pointer; font-weight: 600; font-size: 0.92rem; }
</style>
