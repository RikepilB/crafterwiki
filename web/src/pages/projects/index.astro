---
import Layout from '../../layouts/Layout.astro';
import { corpus, T, base, used } from '../../lib/data.mjs';
import { cardHTML, humanize } from '../../lib/labels.mjs';
import { search } from '../../../../cli/query.mjs';

const initial = search(corpus, { analyzedOnly: true, limit: 1000 });
const inUse = (facet, key) => T[facet].filter((v) => used(key).has(v.id));
const selects = [
  ['domain', 'Domain', inUse('domains', 'domains')],
  ['mechanism', 'Mechanism', inUse('mechanisms', 'mechanisms')],
  ['lens', 'Judging lens', inUse('judging_lenses', 'lenses')],
  ['kind', 'Event kind', T.event_kinds.filter((k) => corpus.hackathons.some((h) => h.kind === k.id))],
];
---
<Layout title="Projects" description="Search hackathon projects by text, domain, winning mechanism, judging lens and kind of event.">
  <p class="eyebrow">Explore</p>
  <h1>Projects</h1>
  <p class="lede">
    Analyzed projects from every indexed hackathon, winners first. Filters combine; include roster entries to
    see what else was submitted.
  </p>
  <form id="explore" class="panel" role="search">
    <div class="form-row">
      <label class="field grow">Search
        <input type="search" name="q" placeholder="lora, procurement, exoplanets, voice agent…" autocomplete="off" />
      </label>
      {selects.map(([name, label, opts]) => (
        <label class="field">{label}
          <select name={name}>
            <option value="">Any</option>
            {opts.map((o) => <option value={o.id}>{humanize(o.id)}</option>)}
          </select>
        </label>
      ))}
    </div>
    <div class="form-row">
      <label class="toggle"><input type="checkbox" name="winners" /> Winners &amp; finalists only</label>
      <label class="toggle"><input type="checkbox" name="entries" /> Include roster entries</label>
      <span id="count" class="meta" aria-live="polite">{initial.length} results</span>
    </div>
  </form>
  <div id="results" class="grid" set:html={initial.map((it) => cardHTML(it, base)).join('')} />
</Layout>

<script>
  import { initExplore } from '../../scripts/explore.js';
  initExplore();
</script>
