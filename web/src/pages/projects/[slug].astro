---
import Layout from '../../layouts/Layout.astro';
import { corpus, base, href, definition, hackathon, eventName, similar, sourceHref } from '../../lib/data.mjs';
import { statusClass, statusLabel, humanize, cardHTML, fmtRange } from '../../lib/labels.mjs';

export function getStaticPaths() {
  return corpus.projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const h = hackathon(p.hackathon);
const it = corpus.items.find((i) => i.slug === p.slug);
const a = p.analysis ?? {};
const track = h.tracks?.find((t) => t.id === p.placement?.track);
const neighbours = similar(corpus, { to: p.slug, limit: 6 });
const links = Object.entries(p.links ?? {}).filter(([, v]) => typeof v === 'string' && /^https?:\/\//.test(v));
const size = p.team?.size;
const team = [size ? `${size} ${size === 1 ? 'person' : 'people'}` : 'Size unknown', (p.team?.countries ?? []).join(', ')]
  .filter(Boolean).join(' · ');
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.name,
  headline: `${p.name} — ${statusLabel(it)} at ${eventName(h)}`,
  description: p.tagline,
  abstract: (a.why_it_stood_out ?? []).map((w) => w.claim).join(' '),
  award: (p.placement?.awards ?? []).join(', ') || undefined,
  keywords: [...(p.domains ?? []), ...(a.mechanisms ?? [])].join(', '),
  isPartOf: { '@type': 'Event', name: eventName(h), startDate: h.start_date ?? undefined },
};
---
<Layout title={`${p.name} · ${eventName(h)}`} description={p.tagline} jsonld={jsonld}>
  <p class="meta crumbs"><a href={href('/projects/')}>Projects</a> / <a href={href(`/hackathons/${h.slug}/`)}>{eventName(h)}</a></p>
  <div class="card-top head-badges">
    <span class={`badge ${statusClass(it.status)}`}>{statusLabel(it)}</span>
    {(p.placement?.awards ?? []).map((award) => <span class="badge accent">{award}</span>)}
    <span class="badge neutral">Confidence: {a.confidence}</span>
  </div>
  <h1>{p.name}</h1>
  <p class="lede">{p.tagline}</p>
  {p.placement?.verification && <p class="callout"><b>Unverified placement.</b> {p.placement.verification}</p>}

  <dl class="facts">
    <div class="fact"><dt>Event</dt><dd><a href={href(`/hackathons/${h.slug}/`)}>{eventName(h)}</a><br /><span class="meta">{fmtRange(h.start_date, h.end_date)}</span></dd></div>
    {track && <div class="fact"><dt>Track / challenge</dt><dd>{track.name}</dd></div>}
    <div class="fact"><dt>Team</dt><dd>{team}</dd></div>
    <div class="fact"><dt>Build</dt><dd>{p.build_style ? humanize(p.build_style) : 'Unknown'}</dd></div>
    <div class="fact"><dt>AI</dt><dd>{(p.tech?.ai_patterns ?? []).length ? p.tech.ai_patterns.map(humanize).join(', ') : 'None stated'}</dd></div>
  </dl>

  <div class="two-col">
    <article>
      <h2>Problem</h2>
      <p>{p.problem ?? 'Not described in the sources.'}</p>
      <h2>Solution</h2>
      <p>{p.solution ?? 'Not described in the sources.'}</p>
      <h2>Demo moment</h2>
      <p class={p.demo_moment ? undefined : 'muted'}>{p.demo_moment ?? 'Not described in the sources.'}</p>
      <h2>Why it stood out</h2>
      <ul class="claims">
        {(a.why_it_stood_out ?? []).map((w) => {
          const src = w.source !== undefined ? p.sources?.[w.source] : null;
          const url = src ? sourceHref(src.url) : null;
          return (
            <li class="claim">
              <span class={`basis ${w.basis}`}>{humanize(w.basis)}</span>
              <span>{w.claim}</span>
              {url && <a class="meta" href={url} rel="noopener">Source ↗</a>}
            </li>
          );
        })}
      </ul>
      {(a.lessons ?? []).length > 0 && (
        <>
          <h2>Lessons for your next hackathon</h2>
          <ul>{a.lessons.map((l) => <li>{l}</li>)}</ul>
        </>
      )}
    </article>
    <aside>
      <h2>Winning mechanisms</h2>
      <dl class="deflist">
        {(a.mechanisms ?? []).map((m) => (
          <div><dt><a href={href(`/mechanisms/${m}/`)}>{humanize(m)}</a></dt><dd>{definition('mechanisms', m)}</dd></div>
        ))}
      </dl>
      <h2>Judging lenses</h2>
      <ul class="chips">{(a.judging_lens ?? []).map((l) => <li><span class="chip" title={definition('judging_lenses', l)}>{humanize(l)}</span></li>)}</ul>
      <h2>Domains</h2>
      <ul class="chips">{(p.domains ?? []).map((d) => <li><a class="chip" href={href(`/projects/?domain=${d}`)}>{humanize(d)}</a></li>)}</ul>
      {(p.tech?.stack ?? []).length > 0 && (
        <>
          <h2>Stack</h2>
          <ul class="chips">{p.tech.stack.map((s) => <li><span class="chip">{s}</span></li>)}</ul>
        </>
      )}
      {links.length > 0 && (
        <>
          <h2>Links</h2>
          <ul class="plain">{links.map(([k, v]) => <li><a href={v} rel="noopener">{humanize(k)} ↗</a></li>)}</ul>
        </>
      )}
      <h2>Use this record</h2>
      <pre>crafterwiki similar --to {p.slug}</pre>
      <p class="meta"><a href={href(`/api/v0/projects/${p.slug}.json`)}>JSON record</a></p>
    </aside>
  </div>

  <h2>Similar situations</h2>
  <p class="muted">
    Projects that share domains, mechanisms or judging lenses — often with a different problem and stack.
    <a href={href(`/similar/?to=${p.slug}`)}>Tune the comparison</a>.
  </p>
  <div class="grid" set:html={neighbours.map((n) => cardHTML(n, base)).join('')} />

  <h2>Sources</h2>
  <ol class="sources">
    {(p.sources ?? []).map((s) => (
      <li>
        {sourceHref(s.url) ? <a href={s.url} rel="noopener">{s.url}</a> : <code>{s.url}</code>}
        <span class="meta"> · {humanize(s.kind)} · retrieved {s.retrieved_at}</span>
        {s.note && <span class="muted"> — {s.note}</span>}
      </li>
    ))}
  </ol>
  {p.curator_notes && <p class="callout info"><b>Curator note.</b> {p.curator_notes}</p>}
</Layout>

<style>
  .head-badges { margin-top: 12px; }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
</style>
