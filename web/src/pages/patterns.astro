---
import Layout from '../layouts/Layout.astro';
import { corpus, T, href, patterns, eventName, hackathon, winners, count, wilson } from '../lib/data.mjs';
import { humanize } from '../lib/labels.mjs';

// Kinds with fewer winners than this are listed in the tables but not charted: a share of 1 or 2
// winners is noise, whatever its confidence range says.
const MIN_N = 5;
// Colour follows the kind of event, never its rank, so it stays the same in every chart.
const SLOT = { 'agency-open-data-challenge': 1, 'open-source-community': 2, 'student-major-league': 3 };
const pct = (x) => Math.round(x * 100);
const share = (k, n) => {
  const w = wilson(k, n);
  return { k, n, p: pct(w.p), lo: pct(w.lo), hi: pct(w.hi) };
};
const noAi = (i) => !i.ai?.length || i.ai.includes('none');
const hardware = (i) => i.build_style === 'hardware-software';

const kinds = T.event_kinds
  .map((k) => ({ id: k.id, definition: k.definition, list: winners.filter((w) => w.event_kind === k.id), events: corpus.hackathons.filter((h) => h.kind === k.id) }))
  .filter((k) => k.events.length);
const withWinners = kinds.filter((k) => k.list.length).sort((a, b) => b.list.length - a.list.length);
const charted = withWinners.filter((k) => k.list.length >= MIN_N);
const notCharted = withWinners.filter((k) => k.list.length < MIN_N);
const without = kinds.filter((k) => !k.list.length);
let nextSlot = Math.max(...Object.values(SLOT)) + 1;
const slotOf = Object.fromEntries(charted.map((k) => [k.id, SLOT[k.id] ?? nextSlot++]));

// Categories: each charted kind's four most common values, ordered by how common they are overall.
const categories = (key) => {
  const picked = new Set(charted.flatMap((k) => count(k.list.flatMap((i) => i[key] ?? [])).slice(0, 4).map(([v]) => v)));
  const pooled = Object.fromEntries(count(charted.flatMap((k) => k.list).flatMap((i) => i[key] ?? [])));
  return [...picked].sort((a, b) => (pooled[b] ?? 0) - (pooled[a] ?? 0) || a.localeCompare(b));
};
const matrix = (key, columns) => categories(key).map((id) => ({
  id,
  cells: columns.map((k) => share(k.list.filter((i) => (i[key] ?? []).includes(id)).length, k.list.length)),
}));
const views = [
  { id: 'mechanisms', label: 'Winning mechanisms', key: 'mechanisms' },
  { id: 'lenses', label: 'Judging criteria', key: 'lenses' },
];
const traits = [
  { id: 'no-ai', label: 'No AI in the product', test: noAi },
  { id: 'hardware', label: 'Custom hardware', test: hardware },
];

const chartData = {
  kinds: charted.map((k) => ({ id: k.id, label: humanize(k.id), n: k.list.length, slot: slotOf[k.id] })),
  views: Object.fromEntries(views.map((v) => [v.id, matrix(v.key, charted).map((r) => ({ label: humanize(r.id), cells: r.cells }))])),
  traits: traits.map((t) => ({ id: t.id, cells: charted.map((k) => share(k.list.filter(t.test).length, k.list.length)) })),
};

const all = winners.length;
const kpis = {
  winners: all,
  eventsWithWinners: new Set(winners.map((w) => w.hackathon)).size,
  events: corpus.hackathons.length,
  kinds: withWinners.length,
  noAi: share(winners.filter(noAi).length, all),
  hardware: share(winners.filter(hardware).length, all),
};

// Worked example for the confidence ranges, computed rather than typed.
const student = withWinners.find((k) => k.id === 'student-major-league');
const example = student ? share(student.list.filter((i) => (i.mechanisms ?? []).includes('physical-artifact')).length, student.list.length) : null;

const overall = patterns(corpus);
const saturation = Object.entries(overall.saturation)
  .map(([slug, s]) => ({ h: hackathon(slug), s }))
  .sort((a, b) => Number(b.s.base_rate_valid) - Number(a.s.base_rate_valid) || b.s.indexed - a.s.indexed);
const HOLDOUT = 'https://github.com/RikepilB/crafterwiki/blob/main/docs/research/holdout-nasa-2024.md';
---
<Layout title="Patterns" description="What confirmed hackathon winners have in common, by kind of event — with sample sizes and 95% ranges on every share.">
  <h1>Patterns by kind of event</h1>
  <p class="lede">What confirmed winners had in common, split by kind of event — because a student hackathon, an open-source challenge and a NASA data challenge reward different things. Every share shows its sample size and a 95% range.</p>

  <section class="stats" aria-label="Key numbers">
    <p class="stat"><b>{kpis.winners}</b><span>confirmed winners and finalists</span></p>
    <p class="stat"><b>{kpis.kinds}</b><span>kinds of event with winners</span><small><span>from</span> {kpis.eventsWithWinners} <span>events with results, of</span> {kpis.events} <span>indexed</span></small></p>
    <p class="stat"><b>{kpis.noAi.p}%</b><span>had no AI in the product</span><small><span>95% range</span> {kpis.noAi.lo}–{kpis.noAi.hi}%</small></p>
    <p class="stat"><b>{kpis.hardware.p}%</b><span>built custom hardware</span><small><span>95% range</span> {kpis.hardware.lo}–{kpis.hardware.hi}%</small></p>
  </section>

  <section class="viz-root" aria-labelledby="wins-heading">
    <h2 id="wins-heading">What wins at each kind of event</h2>
    <p class="muted">Share of each kind's confirmed winners that showed a mechanism or played to a judging criterion. The thin line on each bar is its 95% range.</p>
    <div class="viz-controls">
      <div class="viz-toggle" role="group" aria-label="Show">
        {views.map((v, i) => <button type="button" class="btn" data-view={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{v.label}</button>)}
      </div>
      <ul class="viz-legend" aria-label="Kinds of event">
        {chartData.kinds.map((k) => <li><span class={`swatch s${k.slot}`} aria-hidden="true"></span><span>{k.label}</span> <span class="n">(n = {k.n})</span></li>)}
      </ul>
    </div>
    <div class="viz-card">
      <div class="chart-box tall"><canvas id="chart-wins" role="img" aria-label="Bar chart: share of winners per kind of event for each category. The same numbers are in the table below."></canvas></div>
    </div>
    {views.map((v, vi) => (
      <details class="viz-table" data-table={v.id} open={false}>
        <summary>Show the numbers</summary>
        <div class="table-wrap">
          <table>
            <caption>{v.label}</caption>
            <thead><tr><th scope="col">{v.label}</th>{withWinners.map((k) => <th scope="col"><span>{humanize(k.id)}</span> <span class="n">(n = {k.list.length})</span></th>)}</tr></thead>
            <tbody>
              {matrix(v.key, withWinners).map((r) => (
                <tr>
                  <th scope="row">{humanize(r.id)}</th>
                  {r.cells.map((c) => <td class="nowrap"><b>{c.p}%</b> <span class="meta">{c.k}/{c.n} · {c.lo}–{c.hi}%</span></td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {vi === 0 && notCharted.length > 0 && <p class="meta">{notCharted.map((k) => `${humanize(k.id)} (n = ${k.list.length})`).join(', ')} <span>— too few winners to chart; shown here only.</span></p>}
      </details>
    ))}
  </section>

  <section class="viz-root" aria-labelledby="traits-heading">
    <h2 id="traits-heading">AI and hardware among winners</h2>
    <p class="muted">Does winning take AI or a physical build? It depends on the event.</p>
    <div class="traits">
      {traits.map((t) => (
        <div class="viz-card">
          <h3>{t.label}</h3>
          <div class="chart-box short"><canvas id={`chart-${t.id}`} role="img" aria-label="Bar chart: share of winners per kind of event. The same numbers are in the table below."></canvas></div>
        </div>
      ))}
    </div>
    <details class="viz-table">
      <summary>Show the numbers</summary>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col">Kind of event</th>{traits.map((t) => <th scope="col">{t.label}</th>)}</tr></thead>
          <tbody>
            {withWinners.map((k) => (
              <tr>
                <th scope="row"><span>{humanize(k.id)}</span> <span class="n">(n = {k.list.length})</span></th>
                {traits.map((t) => { const c = share(k.list.filter(t.test).length, k.list.length); return <td class="nowrap"><b>{c.p}%</b> <span class="meta">{c.k}/{c.n} · {c.lo}–{c.hi}%</span></td>; })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <section class="trust" aria-labelledby="trust-heading">
    <h2 id="trust-heading">How much to trust these numbers</h2>
    <ul>
      {example && <li><span>Every share has a 95% range, because the samples are small. Example:</span> <b>{example.k}</b> <span>of</span> <b>{example.n}</b> <span>student winners brought a physical artifact:</span> <b>{example.p}%</b><span>, but the real share could plausibly be anywhere from</span> <b>{example.lo}%</b> <span>to</span> <b>{example.hi}%</b>.</li>}
      <li><span>Kinds of event with fewer than five winners are shown in the tables but not charted.</span></li>
      <li><span>Mechanisms and judging criteria are mostly the curator's reading of each project; every record says who made each claim.</span></li>
      <li><span>Most events are indexed with winners only, so these charts show what winners did — not how often an idea wins.</span> <a href="#saturation">Base rates by event ↓</a></li>
      <li><span>We tested this method on NASA Space Apps 2024 winners it had never seen: the event-kind playbook partly held, and the recommended idea shape matched 2 of 10 winners.</span> <a href={HOLDOUT} target="_blank" rel="noopener">Read the backtest ↗</a></li>
    </ul>
  </section>

  {without.length > 0 && (
    <>
      <h2>No confirmed winners yet</h2>
      <ul>{without.map((k) => <li><b>{humanize(k.id)}</b> — {k.events.map((h) => eventName(h)).join(', ')}</li>)}</ul>
    </>
  )}

  <h2 id="saturation">Saturation by event</h2>
  <p class="muted">Base rates exist only where every submission is indexed.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Event</th><th>Indexed</th><th>Roster</th><th>Top domains</th></tr></thead>
      <tbody>
        {saturation.map(({ h, s }) => (
          <tr>
            <td><a href={href(`/hackathons/${h.slug}/#roster`)}>{eventName(h)}</a></td>
            <td class="nowrap">{s.indexed}{s.of_teams ? ` / ${Number(s.of_teams).toLocaleString('en-US')}` : ''}</td>
            <td><span class={`badge ${s.base_rate_valid ? 'win' : 'neutral'}`}>{s.base_rate_valid ? 'Full · base rate' : humanize(s.roster_coverage)}</span></td>
            <td class="meta">{s.top_domains.map(([d, n]) => `${humanize(d)} ${n}`).join(' · ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script is:inline type="application/json" id="patterns-data" set:html={JSON.stringify(chartData).replace(/</g, '\\u003c')} />
</Layout>

<script>
  import { initPatternCharts } from '../scripts/patterns-charts.js';
  initPatternCharts();
</script>

<style>
  .stats { margin: 26px 0 12px; }
  .stat small { color: var(--muted); display: block; font-size: .78rem; margin-top: 2px; }
  .stat small span { color: inherit; font-size: inherit; }
  .viz-root { margin-top: 40px; }
  /* Categorical slots, validated with the dataviz palette checks against the site's card surfaces
     (dark #191714, light #edece6): all pairs pass CVD and normal-vision separation. */
  .viz-root { --series-1: #3987e5; --series-2: #199e70; --series-3: #d95926; --series-4: #c98500; }
  :global(:root[data-theme=light]) .viz-root { --series-1: #2a78d6; --series-2: #1baf7a; --series-3: #eb6834; --series-4: #eda100; }
  .viz-controls { align-items: center; display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; margin: 14px 0 10px; }
  .viz-toggle { display: flex; flex-wrap: wrap; gap: 8px; }
  .viz-toggle .btn[aria-pressed=true] { border-color: var(--accent); color: var(--ink); background: var(--surface-2); }
  .viz-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; margin: 0; padding: 0; font-size: .85rem; }
  .viz-legend li { align-items: center; display: flex; gap: 6px; }
  .swatch { border-radius: 3px; display: inline-block; height: 12px; width: 12px; }
  .s1 { background: var(--series-1); } .s2 { background: var(--series-2); } .s3 { background: var(--series-3); } .s4 { background: var(--series-4); }
  .n { color: var(--muted); white-space: nowrap; }
  .viz-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; min-width: 0; padding: 14px 16px 8px; }
  .viz-card h3 { font-size: .95rem; margin: 0 0 6px; }
  .chart-box { position: relative; width: 100%; }
  .chart-box.tall { height: 560px; }
  .chart-box.short { height: 190px; }
  .traits { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 14px; }
  .viz-table { margin-top: 10px; }
  .viz-table summary { cursor: pointer; font-size: .88rem; padding: 6px 0; }
  .viz-table caption { caption-side: top; text-align: left; font-weight: 600; padding-bottom: 6px; }
  .viz-table[hidden] { display: none; }
  .trust { background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; margin-top: 40px; padding: 4px 20px 8px; }
  .trust h2 { margin-top: 16px; }
  .trust li { margin-bottom: 8px; }
  .nowrap { white-space: nowrap; }
  @media (max-width: 760px) { .traits { grid-template-columns: minmax(0, 1fr); } .chart-box.tall { height: 640px; } }
</style>
